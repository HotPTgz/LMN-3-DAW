diff --git a/modules/juce_core/native/juce_android_JNIHelpers.cpp b/modules/juce_core/native/juce_android_JNIHelpers.cpp
index 53734691..28ec92d5 100644
--- a/modules/juce_core/native/juce_android_JNIHelpers.cpp
+++ b/modules/juce_core/native/juce_android_JNIHelpers.cpp
@@ -415,6 +415,7 @@ jobject ActivityLifecycleCallbacks::invoke (jobject proxy, jobject method, jobje
     auto* env = getEnv();
 
     auto methodName = juceString ((jstring) env->CallObjectMethod (method, JavaMethod.getName));
+    __android_log_print (ANDROID_LOG_INFO, "LMN3-LIFECYCLE", "%s", methodName.toRawUTF8());
 
     auto activity = env->GetArrayLength (args) > 0 ? env->GetObjectArrayElement (args, 0) : (jobject) nullptr;
     auto bundle   = env->GetArrayLength (args) > 1 ? env->GetObjectArrayElement (args, 1) : (jobject) nullptr;
@@ -441,6 +442,11 @@ jobject ActivityLifecycleCallbacks::invoke (jobject proxy, jobject method, jobje
     else if (methodName == "onActivityPostStarted")            { onActivityPostStarted (activity);                   return nullptr; }
     else if (methodName == "onActivityPostStopped")            { onActivityPostStopped (activity);                   return nullptr; }
 
+    // Newer Android versions add callbacks (e.g. onActivityConfigurationChanged
+    // in Android 14) that this JUCE version doesn't know: ignore them
+    if (methodName.startsWith ("onActivity"))
+        return nullptr;
+
     return AndroidInterfaceImplementer::invoke (proxy, method, args);
 }
 
